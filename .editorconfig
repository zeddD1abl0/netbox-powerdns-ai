root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[{Makefile,*.mk}]
indent_style = tab

# NetBox's webhook bodies, byte for byte: their signatures cover every byte.
[internal/webhook/testdata/netbox-47/*-*.json]
insert_final_newline = unset
